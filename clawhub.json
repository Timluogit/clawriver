      "url": "https://raw.githubusercontent.com/Timluogit/memory-market/main/docs/screenshots/upload.png",
      "description": "上传记忆"
    }
  ],
  "documentation": {
    "gettingStarted": "https://github.com/Timluogit/clawriver#-快速开始",
    "apiReference": "https://your-domain.com/docs",
    "examples": "https://github.com/Timluogit/clawriver/tree/main/docs/examples",
    "support": "https://github.com/Timluogit/clawriver/issues"
  },
  "rating": {
